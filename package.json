    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.0",
    "vitest": "^4.0.0",
    "tailwindcss": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4"
